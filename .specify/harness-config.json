{
  "stack": "typescript",
  "source_dir": "src",
  "test_dir": "tests",
  "file_extension": "*.ts",
  "typecheck_cmd": "npx tsc --noEmit",
  "test_cmd": "npx vitest run",
  "dependency_manifest": "package.json",
  "import_pattern": "(from\\s+['\"].*{pkg}['\"]|require\\(['\"].*{pkg}['\"]\\)|import\\(['\"].*{pkg}['\"]\\))",
  "forbidden_domain_imports": [
    "express", "fastify", "koa", "axios", "prisma", "@prisma/client",
    "typeorm", "mongoose", "react", "react-dom", "vue", "@angular/core", "electron"
  ],
  "forbidden_presentation_imports": [
    "infrastructure", "src/infrastructure", "../infrastructure"
  ]
}
